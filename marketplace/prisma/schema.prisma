// Modelo de dados do marketplace de serviços residenciais.
//
// Convenções:
// - Dinheiro SEMPRE em centavos inteiros (Int, sufixo `Cents`). Percentuais em
//   basis points (Int, sufixo `Bps`; 2000 = 20%). Nada de float em finanças.
// - Pedidos guardam snapshot do catálogo e da comissão no momento da
//   contratação; mudanças futuras de preço não alteram pedidos existentes.
// - Regras que o Prisma não expressa (FK para auth.users, exclusão de horários
//   sobrepostos, RLS, gatilhos) ficam em prisma/sql/*.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identidade e acesso ────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PROVIDER
  SUPPORT
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

/// id = auth.users.id (Supabase Auth). Linha criada por gatilho no cadastro.
model User {
  id        String     @id @db.Uuid
  email     String     @unique
  name      String
  phone     String?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  /// Conta fictícia criada pelo seed de demonstração (nunca usada em produção).
  isDemo    Boolean    @default(false) @map("is_demo")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
  addresses       Address[]
  bookings        Booking[]         @relation("CustomerBookings")
  reviews         Review[]
  tickets         SupportTicket[]
  notifications   Notification[]
  consents        ConsentRecord[]
  auditLogs       AuditLog[]
  quoteRequests   QuoteRequest[]
  evidence        BookingEvidence[]
  credits         CustomerCredit[]

  @@index([role])
  @@map("users")
}

model CustomerProfile {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("provider_status")
}

/// Perfil profissional. `phone`/`whatsapp` são PRIVADOS: só saem do servidor
/// para o cliente de um pedido com pagamento confirmado.
model ProviderProfile {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @unique @map("user_id") @db.Uuid
  displayName      String         @map("display_name")
  bio              String?
  photoUrl         String?        @map("photo_url")
  phone            String?
  whatsapp         String?
  baseCity         String?        @map("base_city")
  baseState        String?        @map("base_state") @db.Char(2)
  experienceYears  Int?           @map("experience_years")
  qualifications   String?
  status           ProviderStatus @default(PENDING)
  statusReason     String?        @map("status_reason")
  approvedAt       DateTime?      @map("approved_at") @db.Timestamptz(6)
  /// Referência da conta de recebimento NO PROVEDOR de pagamento (nunca dados bancários crus).
  payoutAccountRef String?        @map("payout_account_ref")
  ratingSum        Int            @default(0) @map("rating_sum")
  ratingCount      Int            @default(0) @map("rating_count")
  bufferMinutes    Int            @default(30) @map("buffer_minutes")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    ProviderDocument[]
  categories   ProviderCategory[]
  serviceAreas ProviderServiceArea[]
  availability ProviderAvailability[]
  timeOff      ProviderTimeOff[]
  bookings     Booking[]
  payouts      ProviderPayout[]
  reviews      Review[]
  offers       ProviderOffer[]

  @@index([status])
  @@map("provider_profiles")
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("document_status")
}

model ProviderDocument {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String         @map("provider_id") @db.Uuid
  type        String
  storagePath String         @map("storage_path")
  status      DocumentStatus @default(PENDING)
  reviewNote  String?        @map("review_note")
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_documents")
}

model ProviderCategory {
  providerId String   @map("provider_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
  @@index([categoryId])
  @@map("provider_categories")
}

model ProviderServiceArea {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId    String   @map("provider_id") @db.Uuid
  cityId        String   @map("city_id") @db.Uuid
  /// Vazio = cidade inteira.
  neighborhoods String[]
  travelMinutes Int      @default(0) @map("travel_minutes")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  city     City            @relation(fields: [cityId], references: [id])

  @@unique([providerId, cityId])
  @@index([cityId])
  @@map("provider_service_areas")
}

/// Janela semanal de trabalho. weekday 0=domingo..6=sábado; minutos desde 00:00 (horário de Brasília).
model ProviderAvailability {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String @map("provider_id") @db.Uuid
  weekday     Int
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, weekday])
  @@map("provider_availability")
}

model ProviderTimeOff {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6)
  reason     String?

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startsAt])
  @@map("provider_time_off")
}

// ─── Geografia ──────────────────────────────────────────────────────────────

model City {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  state     String   @db.Char(2)
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  serviceAreas ProviderServiceArea[]

  @@unique([name, state])
  @@map("cities")
}

// ─── Catálogo ───────────────────────────────────────────────────────────────

model ServiceCategory {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId              String?  @map("parent_id") @db.Uuid
  slug                  String   @unique
  name                  String
  description           String?
  icon                  String?
  imageUrl              String?  @map("image_url")
  sortOrder             Int      @default(0) @map("sort_order")
  active                Boolean  @default(true)
  /// Exige qualificação/licença verificada do prestador (ex.: eletricista).
  requiresQualification Boolean  @default(false) @map("requires_qualification")
  qualificationNote     String?  @map("qualification_note")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent          ServiceCategory?   @relation("CategoryTree", fields: [parentId], references: [id])
  children        ServiceCategory[]  @relation("CategoryTree")
  services        Service[]
  providers       ProviderCategory[]
  commissionRules CommissionRule[]

  @@index([parentId])
  @@map("service_categories")
}

enum PricingModel {
  FIXED
  CALCULATED
  QUOTE

  @@map("pricing_model")
}

model Service {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId           String       @map("category_id") @db.Uuid
  slug                 String       @unique
  name                 String
  summary              String?
  description          String?
  pricingModel         PricingModel @map("pricing_model")
  /// Só aparece para clientes quando publicado.
  published            Boolean      @default(false)
  active               Boolean      @default(true)
  cancellationPolicyId String?      @map("cancellation_policy_id") @db.Uuid
  sortOrder            Int          @default(0) @map("sort_order")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category           ServiceCategory     @relation(fields: [categoryId], references: [id])
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  packages           ServicePackage[]
  addons             ServiceAddon[]
  priceRules         PriceRule[]
  bookings           Booking[]
  commissionRules    CommissionRule[]
  quoteRequests      QuoteRequest[]
  offers             ProviderOffer[]

  @@index([categoryId])
  @@map("services")
}

enum SuppliesBy {
  CUSTOMER
  PROVIDER
  SHARED

  @@map("supplies_by")
}

/// Escopo padronizado definido pela plataforma. O PREÇO é de cada prestador (ProviderOffer).
model ServicePackage {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId       String     @map("service_id") @db.Uuid
  slug            String
  name            String
  description     String
  durationMinutes Int        @map("duration_minutes")
  professionals   Int        @default(1)
  bedrooms        Int?
  bathrooms       Int?
  maxAreaM2       Int?       @map("max_area_m2")
  includedItems   String[]   @map("included_items")
  excludedItems   String[]   @map("excluded_items")
  suppliesBy      SuppliesBy @default(CUSTOMER) @map("supplies_by")
  suppliesNote    String?    @map("supplies_note")
  conditions      String?
  active          Boolean    @default(true)
  sortOrder       Int        @default(0) @map("sort_order")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]
  offers   ProviderOffer[]

  @@unique([serviceId, slug])
  @@map("service_packages")
}

enum AddonPricing {
  FIXED
  PER_UNIT

  @@map("addon_pricing")
}

model ServiceAddon {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId       String       @map("service_id") @db.Uuid
  name            String
  description     String?
  pricing         AddonPricing @default(FIXED)
  unitLabel       String?      @map("unit_label")
  maxQuantity     Int          @default(1) @map("max_quantity")
  durationMinutes Int          @default(0) @map("duration_minutes")
  active          Boolean      @default(true)
  sortOrder       Int          @default(0) @map("sort_order")

  service Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  offers  ProviderOffer[]

  @@index([serviceId])
  @@map("service_addons")
}

/// Unidade de medida do preço calculado (m², hora...). O preço por unidade,
/// a taxa base e o mínimo vêm da oferta de cada prestador.
model PriceRule {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId      String  @map("service_id") @db.Uuid
  name           String
  unit           String
  unitLabel      String  @map("unit_label")
  minQuantity    Int     @default(1) @map("min_quantity")
  maxQuantity    Int     @map("max_quantity")
  minutesPerUnit Int     @default(0) @map("minutes_per_unit")
  baseMinutes    Int     @default(60) @map("base_minutes")
  active         Boolean @default(true)

  service Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  offers  ProviderOffer[]

  @@index([serviceId])
  @@map("price_rules")
}

/// Preço que o PRESTADOR cobra por um item do catálogo (pacote, adicional ou
/// unidade de preço calculado). O cliente paga esse valor + a comissão da
/// plataforma. Exatamente um alvo por linha (garantido por CHECK no banco).
model ProviderOffer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId    String   @map("provider_id") @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  packageId     String?  @map("package_id") @db.Uuid
  addonId       String?  @map("addon_id") @db.Uuid
  priceRuleId   String?  @map("price_rule_id") @db.Uuid
  /// Pacote/adicional: preço do item. Preço calculado: preço por unidade.
  priceCents    Int      @map("price_cents")
  /// Só para preço calculado: taxa fixa somada às unidades e valor mínimo.
  baseCents     Int      @default(0) @map("base_cents")
  minTotalCents Int      @default(0) @map("min_total_cents")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  addon     ServiceAddon?   @relation(fields: [addonId], references: [id], onDelete: Cascade)
  priceRule PriceRule?      @relation(fields: [priceRuleId], references: [id], onDelete: Cascade)

  @@unique([providerId, packageId])
  @@unique([providerId, addonId])
  @@unique([providerId, priceRuleId])
  @@index([serviceId, active])
  @@map("provider_offers")
}

/// Histórico imutável de alterações de preço/comissão.
model PriceChange {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  field      String
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  changedBy  String?  @map("changed_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("price_changes")
}

enum CommissionScope {
  GLOBAL
  CATEGORY
  SERVICE
  CAMPAIGN

  @@map("commission_scope")
}

/// Regras nunca são editadas: desativa-se a antiga e cria-se uma nova (histórico).
model CommissionRule {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope      CommissionScope
  categoryId String?         @map("category_id") @db.Uuid
  serviceId  String?         @map("service_id") @db.Uuid
  couponId   String?         @map("coupon_id") @db.Uuid
  rateBps    Int             @map("rate_bps")
  validFrom  DateTime        @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo    DateTime?       @map("valid_to") @db.Timestamptz(6)
  active     Boolean         @default(true)
  createdBy  String?         @map("created_by") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  category ServiceCategory? @relation(fields: [categoryId], references: [id])
  service  Service?         @relation(fields: [serviceId], references: [id])
  coupon   Coupon?          @relation(fields: [couponId], references: [id])

  @@index([scope, active])
  @@map("commission_rules")
}

model CancellationPolicy {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String
  /// [{ "minHoursBefore": 24, "refundBps": 10000 }, ...] — ordem decrescente.
  tiers       Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  services Service[]

  @@map("cancellation_policies")
}

enum DiscountType {
  PERCENT
  FIXED

  @@map("discount_type")
}

model Coupon {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String       @unique
  description   String?
  discountType  DiscountType @map("discount_type")
  percentBps    Int?         @map("percent_bps")
  amountCents   Int?         @map("amount_cents")
  minOrderCents Int          @default(0) @map("min_order_cents")
  maxUses       Int?         @map("max_uses")
  usedCount     Int          @default(0) @map("used_count")
  validFrom     DateTime?    @map("valid_from") @db.Timestamptz(6)
  validTo       DateTime?    @map("valid_to") @db.Timestamptz(6)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  bookings        Booking[]
  commissionRules CommissionRule[]

  @@map("coupons")
}

// ─── Endereços ──────────────────────────────────────────────────────────────

model Address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String   @default("Casa")
  cep          String   @db.Char(8)
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String   @db.Char(2)
  notes        String?
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
  @@map("addresses")
}

// ─── Pedidos ────────────────────────────────────────────────────────────────

enum BookingStatus {
  DRAFT
  AWAITING_PROVIDER
  AWAITING_PAYMENT
  PAYMENT_PROCESSING
  CONFIRMED
  IN_PROGRESS
  COMPLETION_PENDING
  COMPLETED
  CANCELLED
  DECLINED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  DISPUTED

  @@map("booking_status")
}

/// ON_TOP: cliente paga preço do prestador + comissão (prestador recebe 100% do seu preço).
/// INCLUDED: comissão descontada do preço (prestador recebe preço − comissão).
enum CommissionMode {
  ON_TOP
  INCLUDED

  @@map("commission_mode")
}

enum CostBearer {
  PLATFORM
  PROVIDER
  PROPORTIONAL

  @@map("cost_bearer")
}

model Booking {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String        @unique
  customerId               String        @map("customer_id") @db.Uuid
  providerId               String?       @map("provider_id") @db.Uuid
  serviceId                String        @map("service_id") @db.Uuid
  packageId                String?       @map("package_id") @db.Uuid
  addressId                String        @map("address_id") @db.Uuid
  couponId                 String?       @map("coupon_id") @db.Uuid
  status                   BookingStatus @default(DRAFT)
  scheduledStart           DateTime      @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd             DateTime      @map("scheduled_end") @db.Timestamptz(6)
  /// Fim + intervalo do prestador; usado pela restrição anti-sobreposição.
  blockedUntil             DateTime      @map("blocked_until") @db.Timestamptz(6)
  /// Prazo para o profissional aceitar/recusar a solicitação.
  providerResponseDeadline DateTime?     @map("provider_response_deadline") @db.Timestamptz(6)
  providerRespondedAt      DateTime?     @map("provider_responded_at") @db.Timestamptz(6)
  declineReason            String?       @map("decline_reason")
  /// Reserva temporária do horário enquanto aguarda pagamento.
  holdExpiresAt            DateTime?     @map("hold_expires_at") @db.Timestamptz(6)
  propertyDetails          Json?         @map("property_details")
  notes                    String?
  /// Snapshot imutável do serviço/pacote/adicionais/política no momento da contratação.
  snapshot                 Json

  /// Soma dos preços do prestador (antes da comissão).
  providerSubtotalCents Int            @map("provider_subtotal_cents")
  commissionMode        CommissionMode @map("commission_mode")
  /// Valor cobrado do cliente antes do desconto.
  grossCents            Int            @map("gross_cents")
  discountCents         Int            @default(0) @map("discount_cents")
  totalCents            Int            @map("total_cents")
  commissionRateBps     Int            @map("commission_rate_bps")
  commissionCents       Int            @map("commission_cents")
  providerShareCents    Int            @map("provider_share_cents")
  paymentFeeCents       Int            @default(0) @map("payment_fee_cents")
  discountBearer        CostBearer     @map("discount_bearer")
  feeBearer             CostBearer     @map("fee_bearer")
  refundedCents         Int            @default(0) @map("refunded_cents")
  /// Parte do total paga com crédito da plataforma (o restante vai ao provedor de pagamento).
  creditAppliedCents    Int            @default(0) @map("credit_applied_cents")

  termsVersion       String?   @map("terms_version")
  termsAcceptedAt    DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  contactReleasedAt  DateTime? @map("contact_released_at") @db.Timestamptz(6)
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Quando o profissional finalizou com foto/vídeo (inicia o prazo de confirmação automática).
  providerFinishedAt DateTime? @map("provider_finished_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason       String?   @map("cancel_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer      User                   @relation("CustomerBookings", fields: [customerId], references: [id])
  provider      ProviderProfile?       @relation(fields: [providerId], references: [id])
  service       Service                @relation(fields: [serviceId], references: [id])
  package       ServicePackage?        @relation(fields: [packageId], references: [id])
  address       Address                @relation(fields: [addressId], references: [id])
  coupon        Coupon?                @relation(fields: [couponId], references: [id])
  items         BookingItem[]
  statusHistory BookingStatusHistory[]
  payments      PaymentTransaction[]
  commission    PlatformCommission?
  payout        ProviderPayout?
  refunds       Refund[]
  review        Review?
  tickets       SupportTicket[]
  evidence      BookingEvidence[]
  credits       CustomerCredit[]

  @@index([customerId, createdAt])
  @@index([providerId, scheduledStart])
  @@index([status])
  @@map("bookings")
}

enum BookingItemKind {
  PACKAGE
  ADDON
  CALCULATED

  @@map("booking_item_kind")
}

model BookingItem {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String          @map("booking_id") @db.Uuid
  kind           BookingItemKind
  refId          String?         @map("ref_id") @db.Uuid
  name           String
  unitPriceCents Int             @map("unit_price_cents")
  quantity       Int
  totalCents     Int             @map("total_cents")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_items")
}

/// Foto/vídeo do serviço finalizado (bucket privado). Obrigatório para o
/// profissional finalizar; libera a confirmação automática e o repasse.
model BookingEvidence {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  storagePath String   @unique @map("storage_path")
  mediaType   String   @map("media_type")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  caption     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("booking_evidence")
}

model BookingStatusHistory {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  actorType  String         @map("actor_type")
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

enum QuoteStatus {
  OPEN
  PROPOSED
  ACCEPTED
  DECLINED
  CANCELLED

  @@map("quote_status")
}

/// Orçamento personalizado: nada é cobrado antes do escopo aprovado.
model QuoteRequest {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String      @map("customer_id") @db.Uuid
  serviceId    String      @map("service_id") @db.Uuid
  description  String
  measurements String?
  photoPaths   String[]    @map("photo_paths")
  city         String
  state        String      @db.Char(2)
  status       QuoteStatus @default(OPEN)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  customer User    @relation(fields: [customerId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])

  @@index([customerId])
  @@map("quote_requests")
}

// ─── Pagamentos ─────────────────────────────────────────────────────────────

enum PaymentMethod {
  PIX
  CARD

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK

  @@map("payment_status")
}

model PaymentTransaction {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  idempotencyKey    String        @unique @map("idempotency_key")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountCents       Int           @map("amount_cents")
  feeCents          Int?          @map("fee_cents")
  /// true = adaptador de SIMULAÇÃO (desenvolvimento). Nunca é dinheiro real.
  isSimulated       Boolean       @map("is_simulated")
  pixQrCode         String?       @map("pix_qr_code")
  pixCopyPaste      String?       @map("pix_copy_paste")
  checkoutUrl       String?       @map("checkout_url")
  /// Status bruto devolvido pelo provedor (diagnóstico/conciliação).
  providerStatus    String?       @map("provider_status")
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(6)
  approvedAt        DateTime?     @map("approved_at") @db.Timestamptz(6)
  failureReason     String?       @map("failure_reason")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([bookingId])
  @@map("payment_transactions")
}

/// Cada evento é gravado uma única vez (provider + eventId) → processamento idempotente.
model PaymentWebhookEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       String
  eventId        String    @map("event_id")
  type           String
  payload        Json
  signatureValid Boolean   @map("signature_valid")
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  error          String?
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

/// Uma linha por pedido (unique) → a comissão nunca é contabilizada duas vezes.
model PlatformCommission {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String    @unique @map("booking_id") @db.Uuid
  rateBps      Int       @map("rate_bps")
  amountCents  Int       @map("amount_cents")
  recognizedAt DateTime  @default(now()) @map("recognized_at") @db.Timestamptz(6)
  reversedAt   DateTime? @map("reversed_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("platform_commissions")
}

enum PayoutStatus {
  ON_HOLD
  SCHEDULED
  PAID
  FAILED
  CANCELLED

  @@map("payout_status")
}

model ProviderPayout {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String       @unique @map("booking_id") @db.Uuid
  providerId         String       @map("provider_id") @db.Uuid
  grossCents         Int          @map("gross_cents")
  commissionCents    Int          @map("commission_cents")
  feeCents           Int          @map("fee_cents")
  discountCents      Int          @default(0) @map("discount_cents")
  netCents           Int          @map("net_cents")
  status             PayoutStatus @default(ON_HOLD)
  providerTransferId String?      @map("provider_transfer_id")
  /// SERVICE = serviço concluído; CANCELLATION_FEE = compensação de cancelamento tardio.
  kind               String       @default("SERVICE")
  note               String?
  isSimulated        Boolean      @map("is_simulated")
  scheduledFor       DateTime?    @map("scheduled_for") @db.Timestamptz(6)
  paidAt             DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking  Booking         @relation(fields: [bookingId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@index([providerId, status])
  @@map("provider_payouts")
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED

  @@map("refund_status")
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String       @map("booking_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amountCents      Int          @map("amount_cents")
  reason           String
  status           RefundStatus @default(REQUESTED)
  idempotencyKey   String       @unique @map("idempotency_key")
  providerRefundId String?      @map("provider_refund_id")
  requestedBy      String?      @map("requested_by") @db.Uuid
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking            @relation(fields: [bookingId], references: [id])
  payment PaymentTransaction @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@map("refunds")
}

// ─── Pós-serviço, suporte e comunicação ─────────────────────────────────────

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED

  @@map("review_status")
}

/// Avaliação do cliente sobre o profissional (estilo Airbnb/Uber). Regras no
/// banco (006_reviews.sql): só pedido CONCLUÍDO, pelas partes do pedido, uma
/// vez; nota/comentário imutáveis; média do profissional recalculada por gatilho.
model Review {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId           String       @unique @map("booking_id") @db.Uuid
  customerId          String       @map("customer_id") @db.Uuid
  providerId          String       @map("provider_id") @db.Uuid
  /// Nota geral 1–5 (obrigatória).
  rating              Int
  punctualityRating   Int?         @map("punctuality_rating")
  qualityRating       Int?         @map("quality_rating")
  communicationRating Int?         @map("communication_rating")
  careRating          Int?         @map("care_rating")
  valueRating         Int?         @map("value_rating")
  /// Elogios / pontos de melhoria (chaves de src/domain/reviews.ts).
  tags                String[]     @default([])
  comment             String?
  providerReply       String?      @map("provider_reply")
  providerRepliedAt   DateTime?    @map("provider_replied_at") @db.Timestamptz(6)
  status              ReviewStatus @default(PUBLISHED)
  moderationReason    String?      @map("moderation_reason")
  moderatedBy         String?      @map("moderated_by") @db.Uuid
  moderatedAt         DateTime?    @map("moderated_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking  Booking         @relation(fields: [bookingId], references: [id])
  customer User            @relation(fields: [customerId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@index([providerId, status])
  @@map("reviews")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

model SupportTicket {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String?      @map("booking_id") @db.Uuid
  openedBy  String       @map("opened_by") @db.Uuid
  category  String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User     @relation(fields: [openedBy], references: [id])

  @@index([status])
  @@map("support_tickets")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  channel   String    @default("IN_APP")
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model ConsentRecord {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  version   String
  accepted  Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("consent_records")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdministrativeSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("administrative_settings")
}

/// Estado do "sistema externo" do provedor de SIMULAÇÃO (só desenvolvimento).
/// A aplicação só confia no webhook assinado + reconsulta, como num provedor real.
model SimGatewayCharge {
  id                String   @id
  externalReference String   @map("external_reference")
  method            String
  amountCents       Int      @map("amount_cents")
  refundedCents     Int      @default(0) @map("refunded_cents")
  status            String   @default("PENDING")
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("sim_gateway_charges")
}

/// Extrato de créditos do cliente (imutável; saldo = soma; nunca negativo — gatilho no banco).
model CustomerCredit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  bookingId   String?  @map("booking_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  /// CANCELLATION_CREDIT | PAYMENT | PAYMENT_REVERSAL | REFUND_TO_CREDIT | ADMIN_ADJUSTMENT
  kind        String
  description String
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("customer_credits")
}
