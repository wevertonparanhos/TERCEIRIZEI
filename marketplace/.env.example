# ── Marca (nome provisório, troque quando definir a identidade final) ──
NEXT_PUBLIC_BRAND_NAME="Lar Pronto"
NEXT_PUBLIC_SITE_URL="http://localhost:3004"

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ── Banco (Project Settings → Database → Connection string) ──
# Runtime: "Transaction pooler" (porta 6543) com ?pgbouncer=true
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Scripts/migrações: "Session pooler" (porta 5432)
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Pagamentos ──
# simulated = adaptador de SIMULAÇÃO (desenvolvimento, nenhum dinheiro real).
# live = provedor real (exige credenciais; ainda não implementado — Fase 3).
PAYMENT_MODE="simulated"
# Segredo HMAC dos webhooks do provedor SIMULADO (em dev há um padrão interno).
PAYMENT_WEBHOOK_SECRET=""

# Asaas — ver docs/pagamentos.md. ASAAS_ENV: "sandbox" (testes) ou "production".
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
