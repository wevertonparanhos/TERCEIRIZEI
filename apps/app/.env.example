# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Usado pelo Prisma para consultar/gravar dados (Project Settings > Database > Connection string).
DATABASE_URL=

# Secreta — só usada em Server Actions, nunca exposta ao navegador. Usada para
# operações administrativas de Storage (upload/URL assinada de documentos).
SUPABASE_SERVICE_ROLE_KEY=
