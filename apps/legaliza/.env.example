# Copie para .env.local e preencha com os dados do projeto Supabase "LEGALIZA.AI"
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Usado pelo Prisma para consultar/gravar dados (Project Settings > Database > Connection string).
DATABASE_URL=

# Secreta — só usada em Server Actions/Components, nunca exposta ao navegador.
SUPABASE_SERVICE_ROLE_KEY=
