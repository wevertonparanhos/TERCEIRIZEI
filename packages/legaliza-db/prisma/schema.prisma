// output isolado (não o padrão hoisted node_modules/@prisma/client) para não
// colidir com o generate de @terceirizei/db no mesmo node_modules do monorepo.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Os 4 perfis pedidos no briefing do LEGALIZA.AI. SUPER_ADMIN é o único sem
// tenantId fixo (admin da plataforma, acesso cross-tenant) — os outros 3
// são sempre escopados a um tenant.
enum RoleName {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATOR
  CLIENT

  @@map("role_name")
}

enum ClientType {
  PF
  PJ

  @@map("client_type")
}

// Classificação real de porte (Receita Federal/Simples Nacional) — não é uma
// categorização inventada.
enum CompanySize {
  MEI
  ME
  EPP
  DEMAIS

  @@map("company_size")
}

enum ProcessType {
  OPENING
  AMENDMENT
  TRANSFORMATION
  CLOSURE

  @@map("process_type")
}

enum ProcessStatus {
  DRAFT
  NEW
  TRIAGE
  WAITING_DOCUMENTS
  READY
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_GOVERNMENT
  PENDING
  COMPLETED
  CANCELLED

  @@map("process_status")
}

enum ProcessStepStatus {
  PENDING
  READY
  IN_PROGRESS
  WAITING
  COMPLETED
  BLOCKED
  CANCELLED

  @@map("process_step_status")
}

enum ProcessPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE

  @@map("process_priority")
}

// Mesmas 8 categorias já validadas em produção no Terceirizei OS.
enum DocumentCategory {
  DOCUMENTACAO_CADASTRAL
  CONTRATOS
  CERTIDOES
  DOCUMENTOS_SOCIETARIOS
  DOCUMENTOS_FISCAIS
  DOCUMENTOS_PESSOAIS
  COMPROVANTES
  OUTROS

  @@map("document_category")
}

enum DocumentRequestStatus {
  PENDENTE
  RECEBIDO
  CANCELADO

  @@map("document_request_status")
}

enum GovernmentSphere {
  FEDERAL
  ESTADUAL
  MUNICIPAL

  @@map("government_sphere")
}

enum ProtocolStatus {
  SUBMITTED
  UNDER_ANALYSIS
  PENDING
  APPROVED
  REJECTED
  COMPLETED

  @@map("protocol_status")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  document  String?
  email     String?
  phone     String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  clients           Client[]
  companies         Company[]
  workflows         Workflow[]
  rules             Rule[]
  processes         Process[]
  documents         Document[]
  documentRequests  DocumentRequest[]
  protocols         Protocol[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  name RoleName @unique

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// id igual ao auth.users.id do Supabase — perfil de aplicação do usuário autenticado.
// tenantId nulo só é válido quando role = SUPER_ADMIN.
model User {
  id        String   @id @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])

  responsibleProcesses     Process[]     @relation("ProcessResponsible")
  responsibleProcessSteps  ProcessStep[] @relation("ProcessStepResponsible")
  uploadedDocuments        Document[]
  uploadedVersions         DocumentVersion[]
  requestedDocuments       DocumentRequest[]
  auditLogs                AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Client {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String
  fantasyName  String?    @map("fantasy_name")
  type         ClientType
  doc          String
  email        String
  phone        String?
  whatsapp     String?
  status       String     @default("ativo")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  companies        Company[]
  processes        Process[]
  documents        Document[]
  documentRequests DocumentRequest[]

  @@unique([tenantId, doc])
  @@index([tenantId])
  @@map("clients")
}

model Company {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  clientId           String       @map("client_id") @db.Uuid
  cnpj               String
  legalName          String       @map("legal_name")
  tradeName          String?      @map("trade_name")
  // Texto livre — sem base oficial IBGE/CONCLA de Natureza Jurídica importada
  // ainda (princípio 65 do briefing: não inventar dados oficiais).
  legalNature        String?      @map("legal_nature")
  companySize        CompanySize? @map("company_size")
  capital            Decimal?     @db.Decimal(14, 2)
  stateRegistration  String?      @map("state_registration")
  municipalRegistration String?   @map("municipal_registration")
  // Objeto social — texto livre, seção 11 do briefing.
  businessPurpose    String?      @map("business_purpose")
  status             String       @default("ativa")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  partners   Partner[]
  activities CompanyActivity[]
  addresses  CompanyAddress[]
  processes  Process[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@index([clientId])
  @@map("companies")
}

model Partner {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  name                   String
  cpf                    String
  qualification          String
  participationPercentage Decimal @map("participation_percentage") @db.Decimal(5, 2)
  capitalContribution    Decimal? @map("capital_contribution") @db.Decimal(14, 2)
  administrator          Boolean  @default(false)
  email                  String?
  phone                  String?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("partners")
}

// Sem base oficial de CNAE importada ainda — cnae/description são texto
// livre digitado pelo operador (princípio 65 do briefing).
model CompanyActivity {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  cnae        String
  description String
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_activities")
}

model CompanyAddress {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  cep          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  // Sem base oficial de municípios (IBGE) integrada ainda — fica nulo até lá.
  ibgeCode     String?  @map("ibge_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_addresses")
}

// Template reutilizável de workflow. Escopado por tenant (sem catálogo global
// cross-tenant nesta fase) — cada escritório configura o próprio.
model Workflow {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  name        String
  processType ProcessType @map("process_type")
  state       String?
  // Texto livre — sem base oficial de Natureza Jurídica importada ainda.
  legalNature String?     @map("legal_nature")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  steps     WorkflowStep[]
  rules     Rule[]
  processes Process[]

  @@index([tenantId])
  @@map("workflows")
}

model WorkflowStep {
  id                String   @id @default(uuid()) @db.Uuid
  workflowId        String   @map("workflow_id") @db.Uuid
  name              String
  description       String?
  order             Int
  estimatedDays     Int?     @map("estimated_days")
  responsibleRole   String?  @map("responsible_role")
  // Texto livre — sem tabela GovernmentAgency ainda (fase de integrações).
  agencyName        String?  @map("agency_name")
  requiresDocument  Boolean  @default(false) @map("requires_document")
  requiresProtocol  Boolean  @default(false) @map("requires_protocol")
  // Reservado pra fase do GovernmentConnector — sem consumidor funcional ainda.
  isAutomated       Boolean  @default(false) @map("is_automated")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workflow     Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  processSteps ProcessStep[]

  @@index([workflowId])
  @@map("workflow_steps")
}

// Motor de regras simplificado (seção 22 do briefing): escolhe qual Workflow
// usar por tipo de processo + UF + natureza jurídica (campos estruturados,
// sem DSL de condição livre nem injeção dinâmica de etapa nesta fase).
model Rule {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  name        String
  processType ProcessType @map("process_type")
  state       String?
  legalNature String?     @map("legal_nature")
  workflowId  String      @map("workflow_id") @db.Uuid
  priority    Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@index([tenantId])
  @@map("rules")
}

model Process {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  clientId              String          @map("client_id") @db.Uuid
  // Nulo só quando type=OPENING (a empresa ainda não existe) — obrigatório
  // nos outros 3 tipos.
  companyId             String?         @map("company_id") @db.Uuid
  workflowId            String?         @map("workflow_id") @db.Uuid
  type                  ProcessType
  status                ProcessStatus   @default(NEW)
  priority              ProcessPriority @default(MEDIA)
  responsibleUserId     String?         @map("responsible_user_id") @db.Uuid
  state                 String
  municipality           String
  startedAt             DateTime        @default(now()) @map("started_at")
  expectedCompletionAt  DateTime?       @map("expected_completion_at")
  completedAt           DateTime?       @map("completed_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  client          Client            @relation(fields: [clientId], references: [id])
  company         Company?          @relation(fields: [companyId], references: [id])
  workflow        Workflow?         @relation(fields: [workflowId], references: [id])
  responsibleUser User?             @relation("ProcessResponsible", fields: [responsibleUserId], references: [id])
  steps           ProcessStep[]
  checklistItems  ChecklistItem[]
  documents       Document[]
  documentRequests DocumentRequest[]
  protocols       Protocol[]

  @@index([tenantId])
  @@index([clientId])
  @@map("processes")
}

model ProcessStep {
  id             String            @id @default(uuid()) @db.Uuid
  processId      String            @map("process_id") @db.Uuid
  // Rastreia a origem no Workflow — nulável pra permitir etapa avulsa no futuro.
  workflowStepId String?           @map("workflow_step_id") @db.Uuid
  name           String
  description    String?
  status         ProcessStepStatus @default(PENDING)
  order          Int
  responsibleUserId String?        @map("responsible_user_id") @db.Uuid
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  dueDate        DateTime?         @map("due_date")
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  process        Process       @relation(fields: [processId], references: [id], onDelete: Cascade)
  workflowStep   WorkflowStep? @relation(fields: [workflowStepId], references: [id])
  responsibleUser User?        @relation("ProcessStepResponsible", fields: [responsibleUserId], references: [id])
  protocols      Protocol[]

  @@index([processId])
  @@map("process_steps")
}

// Sem tabela Checklist separada — liga direto no Process (sempre 1:1, sem
// conceito de checklist reutilizável fora de um processo ainda). Sem
// "condicional" ainda (só obrigatório/opcional) — precisaria do mesmo tipo
// de motor já deliberadamente simplificado na Rule (Fase 3).
model ChecklistItem {
  id          String   @id @default(uuid()) @db.Uuid
  processId   String   @map("process_id") @db.Uuid
  label       String
  required    Boolean  @default(true)
  done        Boolean  @default(false)
  documentId  String?  @map("document_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  process  Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id])

  @@index([processId])
  @@map("checklist_items")
}

model Document {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  clientId       String           @map("client_id") @db.Uuid
  processId      String           @map("process_id") @db.Uuid
  category       DocumentCategory
  name           String
  currentVersion Int              @default(1) @map("current_version")
  uploadedById   String           @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  client         Client            @relation(fields: [clientId], references: [id])
  process        Process           @relation(fields: [processId], references: [id], onDelete: Cascade)
  uploadedBy     User              @relation(fields: [uploadedById], references: [id])
  versions       DocumentVersion[]
  requests       DocumentRequest[]
  checklistItems ChecklistItem[]
  protocols      Protocol[]

  @@index([tenantId])
  @@index([clientId])
  @@index([processId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  version      Int
  storagePath  String   @map("storage_path")
  fileName     String   @map("file_name")
  sizeBytes    Int      @map("size_bytes")
  mimeType     String   @map("mime_type")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
}

model DocumentRequest {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  clientId      String                 @map("client_id") @db.Uuid
  processId     String                 @map("process_id") @db.Uuid
  documentId    String?                @map("document_id") @db.Uuid
  label         String
  deadline      DateTime?
  status        DocumentRequestStatus  @default(PENDENTE)
  notes         String?
  requestedById String                 @map("requested_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id])
  requestedBy User     @relation(fields: [requestedById], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([processId])
  @@map("document_requests")
}

// Catálogo global (sem tenantId) — órgãos públicos são os mesmos pra
// qualquer tenant. Seedado só com os 6 nomes genéricos da seção 30 do
// briefing (Receita Federal, REDESIM, JUCEMG, SEF/MG, Prefeitura,
// Licenciamento) — sem inventar nenhum órgão além desses.
model GovernmentAgency {
  id     String           @id @default(uuid()) @db.Uuid
  name   String
  sphere GovernmentSphere
  state  String?
  active Boolean          @default(true)

  protocols Protocol[]

  @@map("government_agencies")
}

// Registro 100% manual (modo "Manual Assistido", seção 26) — sem
// GovernmentConnector real ainda.
model Protocol {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  processId          String         @map("process_id") @db.Uuid
  processStepId      String?        @map("process_step_id") @db.Uuid
  governmentAgencyId String         @map("government_agency_id") @db.Uuid
  protocolNumber     String         @map("protocol_number")
  submittedAt        DateTime       @default(now()) @map("submitted_at")
  status             ProtocolStatus @default(SUBMITTED)
  url                String?
  // Liga a um Document já enviado (em vez de um path solto) — mais
  // consistente já que o GED existe nesta mesma fase.
  documentId         String?        @map("document_id") @db.Uuid
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  process          Process          @relation(fields: [processId], references: [id], onDelete: Cascade)
  processStep      ProcessStep?     @relation(fields: [processStepId], references: [id])
  governmentAgency GovernmentAgency @relation(fields: [governmentAgencyId], references: [id])
  document         Document?        @relation(fields: [documentId], references: [id])

  @@index([tenantId])
  @@index([processId])
  @@map("protocols")
}

// Trilha de auditoria. logAudit() nunca derruba a ação que chamou — falha de
// log fica só no console, não propaga (mesmo padrão do Terceirizei OS).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType])
  @@map("audit_logs")
}
