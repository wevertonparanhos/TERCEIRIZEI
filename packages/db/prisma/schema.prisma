generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  ADMIN
  GESTOR
  OPERACIONAL
  FINANCEIRO
  CLIENTE

  @@map("role_name")
}

enum ClientType {
  PF
  PJ

  @@map("client_type")
}

enum DemandStatus {
  NOVA
  EM_ANALISE
  AGUARDANDO_CLIENTE
  EM_EXECUCAO
  EM_REVISAO
  CONCLUIDA
  CANCELADA

  @@map("demand_status")
}

enum DemandPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE

  @@map("demand_priority")
}

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  BLOQUEADA
  CONCLUIDA

  @@map("task_status")
}

enum DocumentCategory {
  DOCUMENTACAO_CADASTRAL
  CONTRATOS
  CERTIDOES
  DOCUMENTOS_SOCIETARIOS
  DOCUMENTOS_FISCAIS
  DOCUMENTOS_PESSOAIS
  COMPROVANTES
  OUTROS

  @@map("document_category")
}

enum DocumentRequestStatus {
  PENDENTE
  RECEBIDO
  CANCELADO

  @@map("document_request_status")
}

enum InvoiceStatus {
  PENDENTE
  PAGA
  CANCELADA

  @@map("invoice_status")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      String   @default("internal")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  clients          Client[]
  companies        Company[]
  tags             Tag[]
  serviceTypes     ServiceType[]
  demands          Demand[]
  processes        Process[]
  kanbanStages     KanbanStage[]
  counters         TenantCounter[]
  documents        Document[]
  documentRequests DocumentRequest[]
  invoices         Invoice[]
  auditLogs        AuditLog[]

  @@map("tenants")
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  name RoleName @unique

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// id igual ao auth.users.id do Supabase — perfil de aplicação do usuário autenticado
model User {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  role               Role              @relation(fields: [roleId], references: [id])
  client             Client?           @relation(fields: [clientId], references: [id])
  ownedClients       Client[]          @relation("ClientOwner")
  assignedDemands    Demand[]          @relation("DemandAssignee")
  assignedProcesses  Process[]         @relation("ProcessAssignee")
  assignedTasks      Task[]            @relation("TaskAssignee")
  uploadedDocuments  Document[]
  uploadedVersions   DocumentVersion[]
  requestedDocuments DocumentRequest[]
  createdInvoices    Invoice[]
  auditLogs          AuditLog[]
  demandComments     DemandComment[]

  @@index([tenantId])
  @@map("users")
}

model Client {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  ownerUserId String?    @map("owner_user_id") @db.Uuid
  name        String
  fantasyName String?    @map("fantasy_name")
  type        ClientType @default(PJ)
  doc         String
  email       String
  phone       String?
  whatsapp    String?
  address     String?
  zipCode     String?    @map("zip_code")
  city        String?
  state       String?
  notes       String?
  status      String     @default("ativo")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  owner            User?             @relation("ClientOwner", fields: [ownerUserId], references: [id])
  users            User[]
  contacts         ClientContact[]
  companies        Company[]
  tags             ClientTag[]
  demands          Demand[]
  processes        Process[]
  documents        Document[]
  documentRequests DocumentRequest[]
  invoices         Invoice[]

  @@unique([tenantId, doc])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("clients")
}

model ClientContact {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  role      String
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model Company {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  clientId           String    @map("client_id") @db.Uuid
  cnpj               String
  razaoSocial        String    @map("razao_social")
  nomeFantasia       String?   @map("nome_fantasia")
  inscricaoEstadual  String?   @map("inscricao_estadual")
  inscricaoMunicipal String?   @map("inscricao_municipal")
  cnae               String?
  naturezaJuridica   String?   @map("natureza_juridica")
  regimeTributario   String?   @map("regime_tributario")
  address            String?
  city               String?
  state              String?
  openedAt           DateTime? @map("opened_at")
  status             String    @default("ativa")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  demands   Demand[]
  processes Process[]
  invoices  Invoice[]

  @@unique([tenantId, cnpj])
  @@index([clientId])
  @@map("companies")
}

model Tag {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  label    String
  color    String @default("#14528D")

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  clients   ClientTag[]
  processes ProcessTag[]

  @@unique([tenantId, label])
  @@map("tags")
}

model ClientTag {
  clientId String @map("client_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@map("client_tags")
}

model ServiceType {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  name                String
  defaultPrice        Decimal? @map("default_price") @db.Decimal(12, 2)
  defaultDeadlineDays Int?     @map("default_deadline_days")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  demands   Demand[]
  processes Process[]

  @@unique([tenantId, name])
  @@map("service_types")
}

model Demand {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  number            Int
  clientId          String         @map("client_id") @db.Uuid
  companyId         String?        @map("company_id") @db.Uuid
  serviceTypeId     String         @map("service_type_id") @db.Uuid
  assignedUserId    String?        @map("assigned_user_id") @db.Uuid
  description       String
  priority          DemandPriority @default(MEDIA)
  status            DemandStatus   @default(NOVA)
  requestedDeadline DateTime?      @map("requested_deadline")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  client       Client                 @relation(fields: [clientId], references: [id])
  company      Company?               @relation(fields: [companyId], references: [id])
  serviceType  ServiceType            @relation(fields: [serviceTypeId], references: [id])
  assignedUser User?                  @relation("DemandAssignee", fields: [assignedUserId], references: [id])
  history      DemandStatusHistory[]
  process      Process?
  comments     DemandComment[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([clientId])
  @@index([assignedUserId])
  @@map("demands")
}

model DemandStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  demandId   String        @map("demand_id") @db.Uuid
  fromStatus DemandStatus? @map("from_status")
  toStatus   DemandStatus  @map("to_status")
  userId     String?       @map("user_id") @db.Uuid
  changedAt  DateTime      @default(now()) @map("changed_at")

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([demandId])
  @@map("demand_status_history")
}

// Comentários visíveis tanto pela equipe quanto pelo cliente dono da demanda —
// mesma tabela, RLS decide quem enxerga o quê (autor sempre é um public.users,
// então dá pra saber se foi a equipe ou o próprio cliente que comentou).
model DemandComment {
  id        String   @id @default(uuid()) @db.Uuid
  demandId  String   @map("demand_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([demandId])
  @@map("demand_comments")
}

// contador atômico por tenant — usado para numerar demandas (e, mais tarde, processos)
model TenantCounter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_counters")
}

model Process {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  number         Int
  demandId       String?        @unique @map("demand_id") @db.Uuid
  clientId       String         @map("client_id") @db.Uuid
  companyId      String?        @map("company_id") @db.Uuid
  serviceTypeId  String         @map("service_type_id") @db.Uuid
  assignedUserId String?        @map("assigned_user_id") @db.Uuid
  stageId        String         @map("stage_id") @db.Uuid
  description    String
  priority       DemandPriority @default(MEDIA)
  value          Decimal?       @db.Decimal(12, 2)
  dueAt          DateTime?      @map("due_at")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  demand       Demand?                @relation(fields: [demandId], references: [id])
  client       Client                 @relation(fields: [clientId], references: [id])
  company      Company?               @relation(fields: [companyId], references: [id])
  serviceType  ServiceType            @relation(fields: [serviceTypeId], references: [id])
  assignedUser User?                  @relation("ProcessAssignee", fields: [assignedUserId], references: [id])
  stage        KanbanStage            @relation(fields: [stageId], references: [id])
  stageHistory ProcessStage[]
  tasks        Task[]
  checklist    ProcessChecklistItem[]
  tags         ProcessTag[]
  documents    Document[]
  documentRequests DocumentRequest[]
  invoiceItems InvoiceItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([clientId])
  @@index([assignedUserId])
  @@index([stageId])
  @@map("processes")
}

// colunas do Kanban de processos — configuráveis por tenant, não um enum fixo,
// para o time poder criar/renomear/reordenar etapas conforme o fluxo real de trabalho.
model KanbanStage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String
  position  Int
  color     String   @default("#64748B")
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  processes    Process[]
  movesFrom    ProcessStage[] @relation("StageFrom")
  movesTo      ProcessStage[] @relation("StageTo")

  @@unique([tenantId, position])
  @@map("kanban_stages")
}

model ProcessStage {
  id          String       @id @default(uuid()) @db.Uuid
  processId   String       @map("process_id") @db.Uuid
  fromStageId String?      @map("from_stage_id") @db.Uuid
  toStageId   String       @map("to_stage_id") @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  changedAt   DateTime     @default(now()) @map("changed_at")

  process   Process     @relation(fields: [processId], references: [id], onDelete: Cascade)
  fromStage KanbanStage? @relation("StageFrom", fields: [fromStageId], references: [id])
  toStage   KanbanStage  @relation("StageTo", fields: [toStageId], references: [id])

  @@index([processId])
  @@map("process_stages")
}

model Task {
  id          String         @id @default(uuid()) @db.Uuid
  processId   String         @map("process_id") @db.Uuid
  title       String
  assigneeId  String?        @map("assignee_id") @db.Uuid
  status      TaskStatus     @default(A_FAZER)
  priority    DemandPriority @default(MEDIA)
  dueAt       DateTime?      @map("due_at")
  completedAt DateTime?      @map("completed_at")
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  process  Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([processId])
  @@map("tasks")
}

model ProcessChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  processId String   @map("process_id") @db.Uuid
  label     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("process_checklist_items")
}

model ProcessTag {
  processId String @map("process_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([processId, tagId])
  @@map("process_tags")
}

model Document {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  clientId       String           @map("client_id") @db.Uuid
  processId      String?          @map("process_id") @db.Uuid
  category       DocumentCategory
  name           String
  currentVersion Int              @default(1) @map("current_version")
  uploadedById   String           @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  client     Client            @relation(fields: [clientId], references: [id])
  process    Process?          @relation(fields: [processId], references: [id])
  uploadedBy User              @relation(fields: [uploadedById], references: [id])
  versions   DocumentVersion[]
  requests   DocumentRequest[]

  @@index([tenantId])
  @@index([clientId])
  @@index([processId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  version      Int
  storagePath  String   @map("storage_path")
  fileName     String   @map("file_name")
  sizeBytes    Int      @map("size_bytes")
  mimeType     String   @map("mime_type")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
}

model DocumentRequest {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  clientId      String                 @map("client_id") @db.Uuid
  processId     String?                @map("process_id") @db.Uuid
  documentId    String?                @map("document_id") @db.Uuid
  label         String
  deadline      DateTime?
  status        DocumentRequestStatus  @default(PENDENTE)
  notes         String?
  requestedById String                 @map("requested_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  client      Client    @relation(fields: [clientId], references: [id])
  process     Process?  @relation(fields: [processId], references: [id])
  document    Document? @relation(fields: [documentId], references: [id])
  requestedBy User      @relation(fields: [requestedById], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([processId])
  @@map("document_requests")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  number        Int
  clientId      String        @map("client_id") @db.Uuid
  companyId     String?       @map("company_id") @db.Uuid
  status        InvoiceStatus @default(PENDENTE)
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime      @map("due_date")
  paidAt        DateTime?     @map("paid_at")
  paymentMethod String?       @map("payment_method")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  notes         String?
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  client    Client        @relation(fields: [clientId], references: [id])
  company   Company?      @relation(fields: [companyId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     InvoiceItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  processId   String?  @map("process_id") @db.Uuid
  description String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  process Process? @relation(fields: [processId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

// Trilha de auditoria — quem fez o quê, quando. Escrita explícita a partir das
// Server Actions mais sensíveis (não um interceptor genérico de todo o Prisma).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
