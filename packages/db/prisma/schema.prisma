generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  ADMIN
  GESTOR
  OPERACIONAL
  FINANCEIRO
  CLIENTE

  @@map("role_name")
}

enum ClientType {
  PF
  PJ

  @@map("client_type")
}

// Nome mantido do tempo em que existia um model Demand separado — hoje é a
// prioridade do processo (fusão Demanda/Processo, ver memória do projeto).
enum DemandPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE

  @@map("demand_priority")
}

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  BLOQUEADA
  CONCLUIDA

  @@map("task_status")
}

enum DocumentCategory {
  DOCUMENTACAO_CADASTRAL
  CONTRATOS
  CERTIDOES
  DOCUMENTOS_SOCIETARIOS
  DOCUMENTOS_FISCAIS
  DOCUMENTOS_PESSOAIS
  COMPROVANTES
  OUTROS

  @@map("document_category")
}

enum DocumentRequestStatus {
  PENDENTE
  RECEBIDO
  CANCELADO

  @@map("document_request_status")
}

// aprovação do cliente por documento (não do processo inteiro) — usado
// principalmente pra entregáveis enviados na etapa de conclusão; puramente
// informativo, não trava mudança de etapa.
enum DocumentApprovalStatus {
  PENDENTE
  APROVADO
  RECUSADO

  @@map("document_approval_status")
}

enum InvoiceStatus {
  PENDENTE
  PAGA
  CANCELADA

  @@map("invoice_status")
}

enum RecurrenceFrequency {
  SEMANAL
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL

  @@map("recurrence_frequency")
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  ACEITA
  RECUSADA

  @@map("proposal_status")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      String   @default("internal")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  clients          Client[]
  companies        Company[]
  tags             Tag[]
  serviceTypes     ServiceType[]
  processes        Process[]
  kanbanStages     KanbanStage[]
  counters         TenantCounter[]
  documents        Document[]
  documentRequests DocumentRequest[]
  invoices         Invoice[]
  auditLogs        AuditLog[]
  recurringTasks   RecurringTask[]
  clientNotes      ClientNote[]
  proposals        Proposal[]
  clientMessages   ClientMessage[]

  @@map("tenants")
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  name RoleName @unique

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// id igual ao auth.users.id do Supabase — perfil de aplicação do usuário autenticado
model User {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  role               Role              @relation(fields: [roleId], references: [id])
  client             Client?           @relation(fields: [clientId], references: [id])
  ownedClients       Client[]          @relation("ClientOwner")
  processAssignments ProcessAssignee[]
  assignedTasks      Task[]            @relation("TaskAssignee")
  uploadedDocuments  Document[]
  uploadedVersions   DocumentVersion[]
  requestedDocuments DocumentRequest[]
  createdInvoices    Invoice[]
  auditLogs          AuditLog[]
  processComments    ProcessComment[]
  commentReads       ProcessCommentRead[]
  commentMentions    ProcessCommentMention[]
  processPresence    ProcessPresence[]
  createdImpediments  ProcessImpediment[] @relation("ImpedimentCreatedBy")
  resolvedImpediments ProcessImpediment[] @relation("ImpedimentResolvedBy")
  assignedRecurringTasks   RecurringTask[]           @relation("RecurringTaskAssignee")
  recurringTaskCompletions RecurringTaskCompletion[]
  clientNotes              ClientNote[]
  createdProposals         Proposal[]
  clientMessages           ClientMessage[]
  clientMessageReads       ClientMessageRead[]

  @@index([tenantId])
  @@map("users")
}

model Client {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  ownerUserId String?    @map("owner_user_id") @db.Uuid
  name        String
  fantasyName String?    @map("fantasy_name")
  type        ClientType @default(PJ)
  doc         String
  email       String
  phone       String?
  whatsapp    String?
  address     String?
  zipCode     String?    @map("zip_code")
  city        String?
  state       String?
  notes       String?
  status      String     @default("ativo")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  owner            User?             @relation("ClientOwner", fields: [ownerUserId], references: [id])
  users            User[]
  contacts         ClientContact[]
  companies        Company[]
  tags             ClientTag[]
  processes        Process[]
  documents        Document[]
  documentRequests DocumentRequest[]
  invoices         Invoice[]
  recurringTasks   RecurringTask[]
  clientNotes      ClientNote[]
  proposals        Proposal[]
  messages         ClientMessage[]
  messageReads     ClientMessageRead[]

  @@unique([tenantId, doc])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("clients")
}

model ClientContact {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  role      String
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model Company {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  clientId           String    @map("client_id") @db.Uuid
  cnpj               String
  razaoSocial        String    @map("razao_social")
  nomeFantasia       String?   @map("nome_fantasia")
  inscricaoEstadual  String?   @map("inscricao_estadual")
  inscricaoMunicipal String?   @map("inscricao_municipal")
  cnae               String?
  naturezaJuridica   String?   @map("natureza_juridica")
  regimeTributario   String?   @map("regime_tributario")
  address            String?
  city               String?
  state              String?
  openedAt           DateTime? @map("opened_at")
  status             String    @default("ativa")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  processes Process[]
  invoices  Invoice[]

  @@unique([tenantId, cnpj])
  @@index([clientId])
  @@map("companies")
}

model Tag {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  label    String
  color    String @default("#14528D")

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  clients   ClientTag[]
  processes ProcessTag[]

  @@unique([tenantId, label])
  @@map("tags")
}

model ClientTag {
  clientId String @map("client_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@map("client_tags")
}

model ServiceType {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  name                String
  defaultPrice        Decimal?        @map("default_price") @db.Decimal(12, 2)
  defaultDeadlineDays Int?            @map("default_deadline_days")
  defaultPriority     DemandPriority? @map("default_priority")
  defaultNotes        String?         @map("default_notes")
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now()) @map("created_at")

  tenant             Tenant                         @relation(fields: [tenantId], references: [id])
  processes          Process[]
  checklistTemplate  ServiceChecklistTemplateItem[]

  @@unique([tenantId, name])
  @@map("service_types")
}

// Checklist padrão de um tipo de serviço — copiado (não referenciado) para
// ProcessChecklistItem na abertura do processo, então cada processo pode
// editar/remover itens sem afetar o modelo.
model ServiceChecklistTemplateItem {
  id            String   @id @default(uuid()) @db.Uuid
  serviceTypeId String   @map("service_type_id") @db.Uuid
  label         String
  category      String?
  position      Int
  createdAt     DateTime @default(now()) @map("created_at")

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@unique([serviceTypeId, position])
  @@map("service_checklist_template_items")
}

// Mesma tabela serve equipe e cliente — RLS decide quem enxerga o quê (autor
// sempre é um public.users, então dá pra saber se foi a equipe ou o próprio
// cliente que comentou).
model ProcessComment {
  id        String   @id @default(uuid()) @db.Uuid
  processId String   @map("process_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
  mentions ProcessCommentMention[]

  @@index([processId])
  @@map("process_comments")
}

// @menções num comentário — só membros da equipe podem ser mencionados (não o
// cliente). Gera notificação in-app (readAt), sem e-mail (mesma limitação já
// documentada em Automações — nenhum provedor configurado).
model ProcessCommentMention {
  id              String    @id @default(uuid()) @db.Uuid
  commentId       String    @map("comment_id") @db.Uuid
  mentionedUserId String    @map("mentioned_user_id") @db.Uuid
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  comment       ProcessComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User           @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([mentionedUserId])
  @@map("process_comment_mentions")
}

// "Estou aqui" — marca manual de presença no processo, pra evitar duas
// pessoas trabalhando na mesma coisa sem necessidade. Só staff (nunca
// exposto no portal). Sem job/cron: "ativo" é calculado a cada leitura como
// lastSeenAt dentro dos últimos PRESENCE_EXPIRY_MINUTES (labels.ts) — a marca
// unica "expira sozinha" se a pessoa esquecer de sair ou fechar a aba.
model ProcessPresence {
  processId  String   @map("process_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lastSeenAt DateTime @map("last_seen_at")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([processId, userId])
  @@map("process_presence")
}

// Marca até quando cada membro da equipe já viu os comentários de um processo —
// usado só pra calcular "comentário do cliente não lido", não guarda o comentário em si.
model ProcessCommentRead {
  processId  String   @map("process_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lastReadAt DateTime @map("last_read_at")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([processId, userId])
  @@map("process_comment_reads")
}

// Bloqueio interno da equipe num processo (ex.: "aguardando OK do cliente") —
// só staff vê; não é exposto no portal do cliente nesta etapa.
model ProcessImpediment {
  id           String    @id @default(uuid()) @db.Uuid
  processId    String    @map("process_id") @db.Uuid
  title        String
  createdById  String    @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") @db.Uuid

  process    Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("ImpedimentCreatedBy", fields: [createdById], references: [id])
  resolvedBy User?   @relation("ImpedimentResolvedBy", fields: [resolvedById], references: [id])

  @@index([processId])
  @@map("process_impediments")
}

// contador atômico por tenant — usado para numerar demandas (e, mais tarde, processos)
model TenantCounter {
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_counters")
}

model Process {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  number            Int
  clientId          String         @map("client_id") @db.Uuid
  companyId         String?        @map("company_id") @db.Uuid
  serviceTypeId     String         @map("service_type_id") @db.Uuid
  stageId           String         @map("stage_id") @db.Uuid
  description       String
  priority          DemandPriority @default(MEDIA)
  requestedDeadline DateTime?      @map("requested_deadline")
  dueAt             DateTime?      @map("due_at")
  visibleInPortal   Boolean        @default(true) @map("visible_in_portal")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  client       Client                 @relation(fields: [clientId], references: [id])
  company      Company?               @relation(fields: [companyId], references: [id])
  serviceType  ServiceType            @relation(fields: [serviceTypeId], references: [id])
  stage        KanbanStage            @relation(fields: [stageId], references: [id])
  stageHistory ProcessStage[]
  tasks        Task[]
  checklist    ProcessChecklistItem[]
  tags         ProcessTag[]
  documents    Document[]
  documentRequests DocumentRequest[]
  invoiceItems InvoiceItem[]
  comments     ProcessComment[]
  commentReads ProcessCommentRead[]
  impediments  ProcessImpediment[]
  assignees    ProcessAssignee[]
  installments ProcessInstallment[]
  presence     ProcessPresence[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([clientId])
  @@index([stageId])
  @@map("processes")
}

// múltiplos responsáveis por processo — substitui o antigo Process.assignedUserId
// (FK única) para refletir que mais de uma pessoa pode ser responsável ao
// mesmo tempo (inspirado no seletor multi-responsável do FreelaPRO).
model ProcessAssignee {
  id         String   @id @default(uuid()) @db.Uuid
  processId  String   @map("process_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([processId, userId])
  @@index([userId])
  @@map("process_assignees")
}

// parcelas de pagamento do processo — substitui o antigo Process.value/
// paymentDueDate/paidAt (valor único) pra permitir mais de um pagamento por
// processo (ex.: entrada + parcela final), inspirado no modal "Nova Tarefa"
// do FreelaPRO. Cada parcela tem seu próprio status (PAGO/ATRASADO/PENDENTE),
// calculado do mesmo jeito que o processo único calculava antes.
model ProcessInstallment {
  id             String    @id @default(uuid()) @db.Uuid
  processId      String    @map("process_id") @db.Uuid
  position       Int
  value          Decimal   @db.Decimal(12, 2)
  paymentDueDate DateTime? @map("payment_due_date")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("process_installments")
}

// colunas do Kanban de processos — configuráveis por tenant, não um enum fixo,
// para o time poder criar/renomear/reordenar etapas conforme o fluxo real de trabalho.
model KanbanStage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  label     String
  position  Int
  color     String   @default("#64748B")
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  processes    Process[]
  movesFrom    ProcessStage[] @relation("StageFrom")
  movesTo      ProcessStage[] @relation("StageTo")

  @@unique([tenantId, position])
  @@map("kanban_stages")
}

model ProcessStage {
  id          String       @id @default(uuid()) @db.Uuid
  processId   String       @map("process_id") @db.Uuid
  fromStageId String?      @map("from_stage_id") @db.Uuid
  toStageId   String       @map("to_stage_id") @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  changedAt   DateTime     @default(now()) @map("changed_at")

  process   Process     @relation(fields: [processId], references: [id], onDelete: Cascade)
  fromStage KanbanStage? @relation("StageFrom", fields: [fromStageId], references: [id])
  toStage   KanbanStage  @relation("StageTo", fields: [toStageId], references: [id])

  @@index([processId])
  @@map("process_stages")
}

model Task {
  id          String         @id @default(uuid()) @db.Uuid
  processId   String         @map("process_id") @db.Uuid
  title       String
  assigneeId  String?        @map("assignee_id") @db.Uuid
  status      TaskStatus     @default(A_FAZER)
  priority    DemandPriority @default(MEDIA)
  dueAt       DateTime?      @map("due_at")
  completedAt DateTime?      @map("completed_at")
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  process  Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([processId])
  @@map("tasks")
}

model ProcessChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  processId String   @map("process_id") @db.Uuid
  label     String
  category  String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@map("process_checklist_items")
}

model ProcessTag {
  processId String @map("process_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([processId, tagId])
  @@map("process_tags")
}

model Document {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  clientId       String           @map("client_id") @db.Uuid
  processId      String?          @map("process_id") @db.Uuid
  category       DocumentCategory
  name           String
  currentVersion Int              @default(1) @map("current_version")
  approvalStatus DocumentApprovalStatus? @map("approval_status")
  approvalNote   String?          @map("approval_note")
  uploadedById   String           @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  client     Client            @relation(fields: [clientId], references: [id])
  process    Process?          @relation(fields: [processId], references: [id])
  uploadedBy User              @relation(fields: [uploadedById], references: [id])
  versions   DocumentVersion[]
  requests   DocumentRequest[]

  @@index([tenantId])
  @@index([clientId])
  @@index([processId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  version      Int
  storagePath  String   @map("storage_path")
  fileName     String   @map("file_name")
  sizeBytes    Int      @map("size_bytes")
  mimeType     String   @map("mime_type")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
}

model DocumentRequest {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  clientId      String                 @map("client_id") @db.Uuid
  processId     String?                @map("process_id") @db.Uuid
  documentId    String?                @map("document_id") @db.Uuid
  label         String
  deadline      DateTime?
  status        DocumentRequestStatus  @default(PENDENTE)
  notes         String?
  requestedById String                 @map("requested_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  client      Client    @relation(fields: [clientId], references: [id])
  process     Process?  @relation(fields: [processId], references: [id])
  document    Document? @relation(fields: [documentId], references: [id])
  requestedBy User      @relation(fields: [requestedById], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@index([processId])
  @@map("document_requests")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  number        Int
  clientId      String        @map("client_id") @db.Uuid
  companyId     String?       @map("company_id") @db.Uuid
  status        InvoiceStatus @default(PENDENTE)
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime      @map("due_date")
  paidAt        DateTime?     @map("paid_at")
  paymentMethod String?       @map("payment_method")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  notes         String?
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  client    Client        @relation(fields: [clientId], references: [id])
  company   Company?      @relation(fields: [companyId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     InvoiceItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  processId   String?  @map("process_id") @db.Uuid
  description String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  process Process? @relation(fields: [processId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

// Trilha de auditoria — quem fez o quê, quando. Escrita explícita a partir das
// Server Actions mais sensíveis (não um interceptor genérico de todo o Prisma).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Obrigação recorrente com um cliente (ex.: envio mensal de relatório) — não
// gera Process, é rastreada nela mesma. nextDueAt sempre avança em UTC pela
// frequência a partir do próprio nextDueAt (não de "agora"), pra manter uma
// cadência fixa mesmo se a conclusão atrasar.
model RecurringTask {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  clientId   String              @map("client_id") @db.Uuid
  title      String
  assigneeId String?             @map("assignee_id") @db.Uuid
  frequency  RecurrenceFrequency
  nextDueAt  DateTime            @map("next_due_at")
  active     Boolean             @default(true)
  notes      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  tenant      Tenant                    @relation(fields: [tenantId], references: [id])
  client      Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee    User?                     @relation("RecurringTaskAssignee", fields: [assigneeId], references: [id])
  completions RecurringTaskCompletion[]

  @@index([tenantId])
  @@index([clientId])
  @@map("recurring_tasks")
}

model RecurringTaskCompletion {
  id              String   @id @default(uuid()) @db.Uuid
  recurringTaskId String   @map("recurring_task_id") @db.Uuid
  completedAt     DateTime @default(now()) @map("completed_at")
  completedById   String?  @map("completed_by_id") @db.Uuid

  recurringTask RecurringTask @relation(fields: [recurringTaskId], references: [id], onDelete: Cascade)
  completedBy   User?         @relation(fields: [completedById], references: [id])

  @@index([recurringTaskId])
  @@map("recurring_task_completions")
}

// Anotação interna da equipe sobre um cliente — nunca visível no portal do
// cliente, diferente de ProcessComment (que o cliente também pode ler/postar).
model ClientNote {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("client_notes")
}

// Proposta comercial enviada a um cliente já cadastrado (não a um prospect —
// não existe entidade de lead/prospect no sistema ainda). RASCUNHO é editável
// livremente; ENVIADA trava os itens e fica visível no portal do cliente.
model Proposal {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  number      Int
  clientId    String         @map("client_id") @db.Uuid
  title       String
  status      ProposalStatus @default(RASCUNHO)
  validUntil  DateTime?      @map("valid_until")
  notes       String?
  responseNote String?       @map("response_note")
  sentAt      DateTime?      @map("sent_at")
  respondedAt DateTime?      @map("responded_at")
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  client    Client         @relation(fields: [clientId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     ProposalItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([clientId])
  @@map("proposals")
}

model ProposalItem {
  id          String   @id @default(uuid()) @db.Uuid
  proposalId  String   @map("proposal_id") @db.Uuid
  description String
  value       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_items")
}

// Chat direto com o cliente — geral, não vinculado a um processo específico
// (diferente de ProcessComment). Sem tempo real: atualiza por reload, mesmo
// padrão já usado nos comentários de processo (Realtime não confirmado
// funcionando no navegador de teste deste ambiente, ver memória do projeto).
model ClientMessage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([tenantId])
  @@index([clientId])
  @@map("client_messages")
}

// Marca até quando cada membro da equipe já viu o chat de um cliente — mesmo
// padrão de ProcessCommentRead, usado só pra calcular "não lido".
model ClientMessageRead {
  clientId   String   @map("client_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lastReadAt DateTime @map("last_read_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
  @@map("client_message_reads")
}
