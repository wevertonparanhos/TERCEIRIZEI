# Copie para .env e preencha com os dados do seu projeto Supabase.
# DATABASE_URL (pooled, porta 6543) e DIRECT_URL (direta, porta 5432) estão em
# Project Settings > Database no painel do Supabase.

DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Usados apenas pelo script de seed (packages/db/prisma/seed.ts) para criar o usuário
# administrador de demonstração via Supabase Admin API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
